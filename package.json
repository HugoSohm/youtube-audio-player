{
  "name": "youtube-audio-player",
  "private": true,
  "version": "1.2.1",
  "description": "Chrome extension that turns YouTube search results, channels and playlists into a compact tracklist with a floating player — browse music and type beats more easily.",
  "author": "Hugo Sohm <contact@hugosohm.fr>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoSohm/youtube-audio-player.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/youtubeaudioplayer"
  },
  "bugs": {
    "url": "https://github.com/HugoSohm/youtube-audio-player/issues"
  },
  "homepage": "https://github.com/HugoSohm/youtube-audio-player#readme",
  "keywords": [
    "chrome-extension",
    "youtube",
    "music",
    "type-beats",
    "tracklist",
    "audio-player",
    "manifest-v3"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "package": "node scripts/package.mjs",
    "store-assets": "vite build && node store-assets/render.mjs && vite build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.279",
    "@types/youtube": "^0.1.0",
    "sass": "^1.77.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
